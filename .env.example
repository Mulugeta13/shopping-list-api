# ── Neon PostgreSQL (production) ─────────────────────────────────────────────
# Paste your Neon connection string here (from neon.tech → your project → Connect)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Optional: unpooled connection (used for migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Neon branch info (auto-populated by `neon link`)
NEON_BRANCH=production
NEON_BRANCH_ID=br-xxxx
NEON_FUNCTION_HOST_SUFFIX=xxxx.neon.tech

# ── Local Docker PostgreSQL (development) ────────────────────────────────────
# Used when running locally with docker-compose
LOCAL_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shopping_list
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=shopping_list
